# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API key for LLM access
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: any OpenAI-compatible endpoint, e.g. Vercel AI Gateway (use its key above)
# OPENROUTER_BASE_URL=https://ai-gateway.vercel.sh/v1

# Optional: talk to Anthropic's native Messages API instead (prompt caching works there; the
# OpenAI-compatible shim ignores cache_control). Model IDs must then be Anthropic's own
# (e.g. OPENPOKE_STRONG_MODEL=claude-sonnet-4-5, OPENPOKE_CHEAP_MODEL=claude-haiku-4-5).
# OPENPOKE_LLM_API=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs

# ---------------------------------------------------------------------------
# Agent-overload controls (see README.md)
# ---------------------------------------------------------------------------

# Roster shown to the Interaction Agent: "budgeted" (default) or "all" (upstream behaviour)
# OPENPOKE_ROSTER_STRATEGY=budgeted
# OPENPOKE_ROSTER_MAX=12            # max agents in the prompt per turn
# OPENPOKE_ROSTER_HOT=4             # most-recent agents always shown
# OPENPOKE_ROSTER_RETRIEVAL_K=8     # relevance hits considered
# OPENPOKE_ROSTER_RECENCY_WEIGHT=0.6
# OPENPOKE_AGENT_ACTIVE_TTL_S=172800    # idle > 48h  -> dormant
# OPENPOKE_AGENT_ARCHIVE_TTL_S=1209600  # idle > 14d  -> archived (never for agents with reminders)

# Per-agent tiered memory: "1" (default) or "0" (upstream behaviour: full log in prompt)
# OPENPOKE_AGENT_MEMORY=1
# OPENPOKE_AGENT_MEMORY_BUDGET_CHARS=12000
# OPENPOKE_AGENT_MEMORY_TAIL=12

# Model routing: "tiered" (default) or "strong_only" (upstream behaviour)
# OPENPOKE_ROUTING=tiered
# OPENPOKE_STRONG_MODEL=anthropic/claude-sonnet-4
# OPENPOKE_CHEAP_MODEL=anthropic/claude-3.5-haiku
# OPENPOKE_TIER_EXECUTION=strong    # per-role override: strong | cheap
# OPENPOKE_MODEL_PRICES={"anthropic/claude-sonnet-4":[3,15],"anthropic/claude-3.5-haiku":[0.8,4]}

# Jev typed decisions (TypeSafe System One) - opt-in; see README "Jev typed decisions"
# OPENPOKE_JEV=1
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_BASE_URL=https://api.typesafe.ai          # or https://ai-gateway.vercel.sh/typesafe
# TYPESAFE_MODEL=jev-latest                          # or typesafe-ai/jev on Vercel
# OPENPOKE_JEV_EMAIL_THRESHOLD=0.5     # P(important) below which no chat model runs
# OPENPOKE_JEV_ROUTING_THRESHOLD=0.6   # confidence below which no routing hint is injected

# Second-pass optimisations
# OPENPOKE_AGENT_CONSOLIDATE=1          # redirect duplicate new agents to the existing one
# OPENPOKE_PROMPT_CACHE=1               # cacheable system-prompt block (auto-disables if rejected)
# OPENPOKE_CLASSIFIER_CONCURRENCY=4     # concurrent email classifications
# OPENPOKE_TIER_EXECUTION_TRIGGER=strong  # cheap -> reminder-driven agent runs on the cheap model
# OPENPOKE_JEV_ROUTING=0                # Jev routing hint (benchmarked worse than the LLM; off)
